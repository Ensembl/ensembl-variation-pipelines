profiles {
  standard { process.executor = 'local' }

  lsf {
    executor {
      name            = 'lsf'
      queueSize       = 2000
      submitRateLimit = '50/10sec'
      retry.reason    = "Request from non-LSF host rejected. Job not submitted."
    }

    process {
      queue = 'production'
    }
  }

  slurm {
    executor {
      name            = 'slurm'
      queueSize       = 2000
      //submitRateLimit = '50/10sec'
    }

    process {
      /*
        Time limits are kept short and escalate with task.attempt.

        SLURM's backfill scheduler only places a job in a gap that its time
        limit fits, so short limits let the per-peptide tasks - hundreds of
        thousands of them - use the gaps on a busy cluster instead of waiting
        for full-size allocations. Escalating on retry gives a task that is
        stopped on time a longer limit on its next attempt.

        These are starting points; right-size them from reports/trace.txt.
      */
      time = { 2.h * task.attempt }

      // PSI-BLAST against UniRef90, and PolyPhen-2, are the long ones.
      withName: 'align_peptides|run_pph2_on_all_aminoacid_substitutions' {
        time = { 8.h * task.attempt }
      }
      withName: 'run_sift_on_all_aminoacid_substitutions' {
        time = { 4.h * task.attempt }
      }
      // Merges one SQLite database per scored peptide, so it scales with the
      // number of predictions rather than with any single task.
      withName: 'postprocess_sqlite_db' {
        time = { 12.h * task.attempt }
      }
    }
  }
}

notification {
  enabled = true
  to = "${USER}@ebi.ac.uk"
}

singularity {
  enabled    = true
  autoMounts = true
}

process {
  withLabel: long { time = '7d' }

  // One entry per attempt: maxRetries 3 means attempts 1-4, so this list must
  // keep at least maxRetries+1 entries. Groovy returns null for an index past
  // the end rather than throwing, so a short list would silently leave the
  // memory request unset on the last attempt.
  memory = { ["500 MB", "4 GB", "12 GB", "200 GB"][task.attempt - 1] }

  /*
    Retry the resource limits, fail on anything else:
      - 130: job exceeded LSF allocated memory
      - 137: SIGKILL, the SLURM cgroup out-of-memory killer
      - 140: job exceeded SLURM allocated resources (memory, CPU, time)
      - 143: SIGTERM, how SLURM stops a job that hits its time limit
      - null: killed before it could write .exitcode
    Each retry gets the next memory rung and a longer time limit, so the same
    task can succeed on a later attempt.
  */
  errorStrategy = { task.exitStatus == null ||
                    task.exitStatus in 130..140 ||
                    task.exitStatus == 143 ? 'retry' : 'finish' }
  withLabel: retry_before_ignoring {
   errorStrategy = { task.exitStatus == null ||
                     task.exitStatus in 130..140 ||
                     task.exitStatus == 143 ? 'retry' : 'ignore' }
  }
  maxRetries = 3
}

trace {
    enabled = true
    overwrite = true
    file = "reports/trace.txt"
    // Requested (cpus/memory/time) next to actual (%cpu/peak_rss/realtime) so
    // resource requests can be right-sized from a real run.
    fields = 'task_id,process,tag,status,exit,attempt,cpus,memory,time,duration,realtime,%cpu,peak_rss,peak_vmem'
}

dag {
    enabled = true
    overwrite = true
    file = "reports/flowchart.html"
}

timeline {
    enabled = true
    overwrite = true
    file = "reports/timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "reports/report.html"
}
