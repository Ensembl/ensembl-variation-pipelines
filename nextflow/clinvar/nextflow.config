params {
  // ClinVar release
  clinvar_base_url = 'https://ftp.ncbi.nlm.nih.gov/pub/clinvar'
  month = null
  assemblies = 'GRCh38,GRCh37'

  // Gene set VEP annotates with, labelled e.g. 'GENCODE 50'
  gff_grch38 = null
  gff_grch37 = null
  gene_set_grch38 = null
  gene_set_grch37 = null

  // Ensembl gene to NCBI gene ID maps that make_ncbi_map.py writes
  ncbi_map_grch38 = null
  ncbi_map_grch37 = null

  // local overrides for the ClinVar inputs
  vcv_xml = null
  rcv_xml = null
  vcf_grch38 = null
  vcf_grch37 = null
  allow_date_mismatch = false

  // output
  force = false
  publish_dir = null
  work_dir = null
  keep_releases = 3

  // gates
  max_problem_fraction = 0.01
  min_clnsuba_fraction = 0.99

  // SLURM
  queue = 'production'
  fetch_queue = 'datamover'
}

// The work directory holds intermediate files. -work-dir on the command line
// takes precedence.
workDir = params.work_dir ?: 'work'

profiles {
  standard {
    executor.name = 'local'
  }

  slurm {
    executor.name = 'slurm'
    process.queue = params.queue

    process {
      withLabel: fetch {
        queue = params.fetch_queue
      }
    }
  }
}

process {
  cpus   = 1
  memory = { 4.GB * task.attempt }
  time   = { 2.hour * task.attempt }

  errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
  maxRetries    = 1

  withLabel: fetch {
    memory = { 1.GB * task.attempt }
    time   = { 6.hour * task.attempt }
  }

  withLabel: db {
    memory = { 8.GB * task.attempt }
    time   = { 6.hour * task.attempt }
  }
}

trace {
  enabled = true
  overwrite = true
  file = "reports/trace.txt"
}

timeline {
  enabled = true
  overwrite = true
  file = "reports/timeline.html"
}

report {
  enabled = true
  overwrite = true
  file = "reports/report.html"
}
