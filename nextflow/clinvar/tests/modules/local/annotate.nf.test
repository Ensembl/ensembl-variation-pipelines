nextflow_process {

    name "Test Process ANNOTATE"
    script "modules/local/annotate.nf"
    process "ANNOTATE"

    setup {
        run("BUILD_DB") {
            script "modules/local/build_db.nf"
            process {
                """
                def xml = "$baseDir/tests/data/clinvar_ftp/xml"
                input[0] = file("\${xml}/ClinVarVCVRelease_2026-08.xml.gz")
                input[1] = file("\${xml}/RCV_release/ClinVarRCVRelease_2026-08.xml.gz")
                input[2] = "20260804"
                """
            }
        }

        run("BUILD_GENE_MAP") {
            script "modules/local/build_gene_map.nf"
            process {
                """
                def data = "$baseDir/tests/data"
                def core = "\${data}/ensembl/homo_sapiens_core_116_37"
                input[0] = Channel.of(
                    [
                        "GRCh38",
                        file("\${data}/gff/Homo_sapiens.GRCh38.116.chr.gff.gz"),
                        [file("\${data}/ensembl/Homo_sapiens.GRCh38.116.entrez.tsv.gz")]
                    ],
                    [
                        "GRCh37",
                        file("\${data}/gff/genes.gff3.bgz"),
                        ["gene", "object_xref", "xref", "external_db"].collect { name -> file("\${core}/\${name}.txt.gz") }
                    ]
                )
                """
            }
        }
    }

    test("Adds GENEENSG by rule G5 on both assemblies") {

        when {
            params {
                cache_dir = "$outputDir/cache"
                ensembl_release = 116
            }
            process {
                """
                def vcfs = "$baseDir/tests/data/clinvar_ftp"
                input[0] = Channel.of(
                    ["GRCh38", file("\${vcfs}/vcf_GRCh38/archive_2.0/2026/clinvar_20260804.vcf.gz")],
                    ["GRCh37", file("\${vcfs}/vcf_GRCh37/archive_2.0/2026/clinvar_20260804.vcf.gz")]
                )
                    .join(BUILD_GENE_MAP.out.gene_map)
                    .combine(BUILD_DB.out.db)
                    .combine(Channel.of("20260804"))
                """
            }
        }

        then {
            assert process.success
            assert process.out.vcf.size() == 2

            def outputs = process.out.vcf.collectEntries { out -> [(out[0]): out] }

            def info = { vcf ->
                path(vcf).linesGzip.findAll { line -> !line.startsWith("#") }.collectEntries { line ->
                    def cols = line.split("\t")
                    [(cols[2]): cols[7].split(";").collectEntries { field ->
                        def kv = field.split("=", 2)
                        [(kv[0]): kv.size() > 1 ? kv[1] : ""]
                    }]
                }
            }

            def expected = [
                "17788": "ENSG00000175206",
                "31109": "ENSG00000122482",
                "9000006": "ENSG00000122482+ENSG00000112276",
                "9000001": null,
                "66881": "ENSG00000160789",
                "9000004": "ENSG00000160789",
                "218475": "ENSG00000115221",
                "9000003": null,
                "206926": "ENSG00000144285",
                "35541": "ENSG00000112992",
                "9000005": null,
                "626313": "ENSG00000112276",
                "9000002": null,
            ]
            def expected37 = expected + ["17788": "ENSG00000175206+ENSG00000242349"]

            ["GRCh38": expected, "GRCh37": expected37].each { asm, genes ->
                def (_asm, vcf, tbi, stats, md5) = outputs[asm]
                def records = info(vcf)

                assert records.collectEntries { id, fields -> [(id): fields.GENEENSG] } == genes

                // no XML row: GENEENSG without the XML fields
                assert records["9000004"].CLNSUBA == null
                assert records["626313"].CLNSUBA == null
                assert records["66881"].CLNSUBA != null

                assert path(vcf).linesGzip.any { line -> line.startsWith("##INFO=<ID=GENEENSG,") }
                assert path(tbi).exists()

                def counts = path(stats).json
                assert counts.records == 13
                assert counts.with_geneinfo == 12
                assert counts.with_geneensg == 9
                assert counts.top_unresolved*.get(0).contains("LOC130008987:130008987")

                def input = path("$baseDir/tests/data/clinvar_ftp/vcf_${asm}/archive_2.0/2026/clinvar_20260804.vcf.gz")
                assert new File(md5.toString()).text.trim() == input.md5
            }
        }
    }
}
