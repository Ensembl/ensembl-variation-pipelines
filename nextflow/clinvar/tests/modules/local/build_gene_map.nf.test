nextflow_process {

    name "Test Process BUILD_GENE_MAP"
    script "modules/local/build_gene_map.nf"
    process "BUILD_GENE_MAP"

    test("GRCh38 with a gene set label") {

        when {
            process {
                """
                input[0] = channel.of([
                    "GRCh38",
                    file("$baseDir/tests/data/gff/Homo_sapiens.GRCh38.116.chr.gff.gz"),
                    file("$baseDir/tests/data/ncbi_map/grch38.tsv.gz"),
                    "GENCODE 50"
                ])
                """
            }
        }

        then {
            assert process.success

            def map = path(process.out.gene_map.get(0).get(1)).json
            assert map.provenance.assembly == "GRCh38"
            assert map.provenance.gene_set == "GENCODE 50"
            assert map.provenance.gff.name == "Homo_sapiens.GRCh38.116.chr.gff.gz"
            assert map.provenance.gff.md5 == new File("$baseDir/tests/data/gff/Homo_sapiens.GRCh38.116.chr.gff.gz").bytes.md5()
            assert map.provenance.ncbi_map.name == "grch38.tsv.gz"
            assert map.provenance.ncbi_map.md5 == new File("$baseDir/tests/data/ncbi_map/grch38.tsv.gz").bytes.md5()
            assert "ENSG00000112276" in map.gene_ids

            // BVES is not a GFF gene name, so it resolves through its NCBI ID
            assert !map.by_name.containsKey("BVES")
            assert map.by_ncbi["11149"] == ["ENSG00000112276"]

            // POC1B carries its own NCBI ID and the readthrough ID 133039968, so
            // neither maps. 130008987 has no Ensembl xref.
            assert !map.by_ncbi.containsKey("133039968")
            assert !map.by_ncbi.containsKey("130008987")
        }
    }

    test("GRCh37 without a gene set label") {

        when {
            process {
                """
                input[0] = channel.of([
                    "GRCh37",
                    file("$baseDir/tests/data/gff/genes.gff3.bgz"),
                    file("$baseDir/tests/data/ncbi_map/grch37.tsv.gz"),
                    ""
                ])
                """
            }
        }

        then {
            assert process.success

            def map = path(process.out.gene_map.get(0).get(1)).json
            assert map.provenance.assembly == "GRCh37"
            assert map.provenance.containsKey("gene_set")
            assert map.provenance.gene_set == null
            assert map.provenance.ncbi_map.name == "grch37.tsv.gz"
            assert map.by_name["BVES"] == ["ENSG00000112276"]
            assert map.by_ncbi["11149"] == ["ENSG00000112276"]

            // ITGB6 carries two NCBI IDs on GRCh37, so neither maps
            assert !map.by_ncbi.containsKey("100505984")
            assert !map.by_ncbi.containsKey("3694")
            assert map.by_name["ITGB6"] == ["ENSG00000115221"]
        }
    }

    test("Fails on an NCBI map without the header") {

        when {
            process {
                """
                input[0] = channel.of([
                    "GRCh38",
                    file("$baseDir/tests/data/gff/Homo_sapiens.GRCh38.116.chr.gff.gz"),
                    file("$baseDir/tests/data/gff/genes.gff3.bgz"),
                    ""
                ])
                """
            }
        }

        then {
            assert process.failed
            assert process.errorMessage.contains("does not start with the header gene_stable_id, ncbi_gene_id")
        }
    }
}
