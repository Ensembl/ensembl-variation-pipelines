nextflow_process {

    name "Test Process FETCH_FILE"
    script "modules/local/fetch_file.nf"
    process "FETCH_FILE"

    test("Verifies an NCBI md5 file") {

        when {
            process {
                """
                def xml = "file://$baseDir/tests/data/clinvar_ftp/xml/ClinVarVCVRelease_2026-08.xml.gz"
                input[0] = Channel.of(["vcv_xml", xml, xml + ".md5", ""])
                """
            }
        }

        then {
            assert process.success

            def (key, fetched) = process.out.file.get(0)
            assert key == "vcv_xml"
            assert path(fetched).fileName.toString() == "ClinVarVCVRelease_2026-08.xml.gz"
            assert path(fetched).md5 == path("$baseDir/tests/data/clinvar_ftp/xml/ClinVarVCVRelease_2026-08.xml.gz").md5
        }
    }

    test("Verifies an Ensembl CHECKSUMS entry") {

        when {
            process {
                """
                def dir = "file://$baseDir/tests/data/ensembl/homo_sapiens_core_116_37"
                input[0] = Channel.of(["mapping_GRCh37", dir + "/xref.txt.gz", "", "15853 1"])
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.file.get(0).get(1)).fileName.toString() == "xref.txt.gz"
        }
    }
}
