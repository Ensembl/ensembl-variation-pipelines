process {
process {
    withName: 'LOAD_PHENOTYPES' {
        ext.prefix = { meta.source_name.toLowerCase() }
        publishDir = [
            path: { "${params.outdir}/${meta.source_name.toLowerCase()}/${meta.species_production_name}" + (meta.assembly ? "/${meta.assembly}" : '') },
            mode: 'copy',
            overwrite: true,
        ]
    }

    withName: 'DOWNLOAD_CLINVAR' {
        publishDir = [
            path: { "${params.outdir}/clinvar/inputs" },
            mode: 'copy',
            overwrite: true,
        ]
    }

    withName: 'PARSE_CLINVAR' {
        time = '3h'
        ext.prefix = 'clinvar'
        ext.args = {
            def directory = "'" + projectDir.toString().replace("'", "'\"'\"'") + "'"
            "--pipeline-directory ${directory}"
        }
        publishDir = [
            path: { "${params.outdir}/clinvar/${meta.species_production_name}/${meta.assembly}" },
            mode: 'copy',
            overwrite: true,
        ]
    }

    withName: 'DOWNLOAD_G2P' {
        publishDir = [
            path: { "${params.outdir}/g2p/inputs" },
            mode: 'copy',
            overwrite: true,
        ]
    }

    withName: 'PARSE_G2P' {
        ext.prefix = 'g2p'
        ext.args = {
            def directory = "'" + projectDir.toString().replace("'", "'\"'\"'") + "'"
            "--pipeline-directory ${directory}"
        }
        publishDir = [
            path: { "${params.outdir}/g2p/${meta.species_production_name}" + (meta.assembly ? "/${meta.assembly}" : '') },
            mode: 'copy',
            overwrite: true,
        ]
    }
}
