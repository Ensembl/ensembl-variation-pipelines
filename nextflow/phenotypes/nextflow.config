// Set pipeline defaults, local and Slurm execution options, and task resources.
// Choose where Nextflow writes its execution reports.

manifest {
    name = 'phenotypes'
    mainScript = 'main.nf'
    nextflowVersion = '26.04.0'
}

params {
    outdir = "${projectDir}/results"
}

includeConfig '../shared/conf/source.config'
includeConfig '../shared/conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    standard {
        process.executor = 'local'
        env.PATH = "${projectDir}/.venv/bin:${System.getenv('PATH')}"
    }

    slurm {
        process.executor = 'slurm'
    }

    docker {
        docker.enabled = true
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }

    conda {
        conda.enabled = true
    }
}

process {
    cpus = 1
    memory = '2 GB'
    time = '2h'
    errorStrategy = 'terminate'

}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/reports/trace.txt"
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/reports/report.html"
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/reports/timeline.html"
}

dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/reports/flowchart.html"
}
