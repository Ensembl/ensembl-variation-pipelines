process {
    withName: 'EXTRACT_CLINVAR' {
        ext.prefix = 'clinvar'
        publishDir = [
            path: { "${params.outdir}/clinvar/evidence/${meta.species_production_name}/${meta.assembly}" },
            mode: 'copy',
            overwrite: true,
        ]
    }

    withName: 'DOWNLOAD_CLINVAR' {
        publishDir = [
            path: { "${params.outdir}/clinvar/inputs" },
            mode: 'copy',
            overwrite: true,
        ]
    }
}
