manifest {
    name = 'variation-source-extraction'
    mainScript = 'main.nf'
    nextflowVersion = '26.04.0'
}

params {
    outdir = 'results'
}

includeConfig 'conf/source.config'
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

process.executor = 'local'

profiles {
    standard {
        env.PATH = "${projectDir}/.venv/bin:${System.getenv('PATH')}"
    }
}
