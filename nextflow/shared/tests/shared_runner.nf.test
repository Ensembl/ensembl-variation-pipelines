nextflow_pipeline {
    name 'Standalone shared ClinVar download and extraction runner'
    script 'main.nf'
    tag 'pipeline'
    tag 'shared_runner'

    test('Extract local RCV evidence for both assembly contexts without phenotypes') {
        when {
            params {
                source_config = "$baseDir/tests/data/source_config.json"
                outdir = "$outputDir/results"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.stdout.join('\n').contains('RCV: ') },
                { assert workflow.stdout.join('\n').contains('/tests/data/rcv.xml') },
                { assert workflow.stdout.join('\n').contains('VCV: ') },
                { assert workflow.stdout.join('\n').contains('/tests/data/vcv.xml') },
                { assert file("$outputDir/results/clinvar/evidence/homo_sapiens/GRCh38/clinvar.jsonl").readLines().size() == 3 },
                { assert file("$outputDir/results/clinvar/evidence/homo_sapiens/GRCh38/clinvar.jsonl").text.contains('rs999999') },
                { assert file("$outputDir/results/clinvar/evidence/homo_sapiens/GRCh38/clinvar.summary.json").text.contains('"n_records_emitted": 2') },
                { assert file("$outputDir/results/clinvar/evidence/homo_sapiens/GRCh38/rejections.jsonl").text.contains('unsupported_genotype_set') },
                { assert file("$outputDir/results/clinvar/evidence/homo_sapiens/GRCh37/clinvar.jsonl").readLines().size() == 1 },
                { assert file("$outputDir/results/clinvar/evidence/homo_sapiens/GRCh37/clinvar.summary.json").text.contains('"n_records_rejected": 3') },
                { assert file("$outputDir/results/clinvar/evidence/homo_sapiens/GRCh37/rejections.jsonl").readLines().size() == 3 }
            )
        }
    }

    test('Default common asset downloads and extracts with published outputs - stub') {
        options '-stub-run'
        when {
            params {
                outdir = "$outputDir/results"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert file("$outputDir/results/clinvar/inputs/ClinVarRCVRelease_00-latest.xml.gz").exists() },
                { assert file("$outputDir/results/clinvar/inputs/ClinVarVCVRelease_00-latest.xml.gz").exists() },
                { assert file("$outputDir/results/clinvar/evidence/homo_sapiens/GRCh38/clinvar.jsonl").exists() },
                { assert file("$outputDir/results/clinvar/evidence/homo_sapiens/GRCh38/clinvar.summary.json").exists() },
                { assert file("$outputDir/results/clinvar/evidence/homo_sapiens/GRCh38/rejections.jsonl").exists() }
            )
        }
    }
}
