process {
    withName: 'EXTRACT_CLINVAR_SYNONYMS' {
        ext.prefix = 'clinvar'
        publishDir = [
            path: { "${params.outdir}/clinvar/${meta.species_production_name}/${meta.assembly}/synonyms" },
            mode: 'copy',
            overwrite: true,
        ]
    }
    withName: 'DOWNLOAD_CLINVAR' {
        publishDir = [
            path: "${params.outdir}/clinvar/inputs",
            mode: 'copy',
            overwrite: true,
        ]
    }
}
