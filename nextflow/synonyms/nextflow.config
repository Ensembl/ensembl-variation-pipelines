manifest {
    name = 'variant-synonyms'
    mainScript = 'main.nf'
    nextflowVersion = '26.04.0'
}

params.outdir = "${launchDir}/results/synonyms"
includeConfig '../shared/conf/source.config'
includeConfig '../shared/conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    standard {
        process.executor = 'local'
        env.PATH = "${projectDir}/.venv/bin:${System.getenv('PATH')}"
    }
    slurm {
        process.executor = 'slurm'
        env.PATH = "${projectDir}/.venv/bin:${System.getenv('PATH')}"
    }
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    conda {
        conda.enabled = true
    }
}

process.errorStrategy = 'terminate'
