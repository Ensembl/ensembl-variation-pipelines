nextflow_process {

    name "Test Process CONCAT_BEDS"
    script "../main.nf"
    process "CONCAT_BEDS"

    test("concat_beds") {

        when {
            process {
                """
                def meta = [
                    "source": "test"
                ]
                
				input[0] = tuple(meta, file("${moduleDir}/tests/testdata/test_bed*.bed"))
                """
            }
        }

        then {
            assert process.success
            
            // assert the content of the output file
            def output_file = process.out.get(0).get(0).get(1)
            def lines = file(output_file).readLines()
            assert lines.size() == 5

            assert file(output_file).name == "variant-test.bed"
            assert path(output_file).md5 == "60e90d0f0fcaf973f97124d380334ed2"

			// asssert temp and all.bed files are deleted
			assert ! file(workDir + "/all.bed").exists()
			assert ! file(workDir + "/tmp").exists()
		}
    }
}
