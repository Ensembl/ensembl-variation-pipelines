nextflow_process {

    name "Test process GENERATE_SYNONYM_FILE"
    script "../main.nf"
    process "GENERATE_SYNONYM_FILE"

    test("synonym_file") {

        def test_meta = [
            'genome':'homo_sapiens_grch38',
            'species':'homo_sapiens',
            'assembly':'GRCh38',
            'synonym_file':"${workDir}/homo_sapiens_grch38.synonyms"
        ]
        def test_meta_json = groovy.json.JsonOutput.toJson(test_meta)

        when {
            params {
                version = 110
                ini_file = "${baseDir}/tests/testdata/test_db.ini"
            }
            process {
                """
                def meta = new groovy.json.JsonSlurperClassic().parseText('''${test_meta_json}''')
                input[0] = meta
                """
            }
        }

        then {

            assert process.success

            assert path("${workDir}/homo_sapiens_grch38.synonyms").md5 == path("tests/data/homo_sapiens_grch38.synonyms").md5
        }
    }
}
