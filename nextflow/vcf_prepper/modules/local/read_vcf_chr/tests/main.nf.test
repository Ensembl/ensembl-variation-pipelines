nextflow_process {

    name "Test process READ_VCF_CHR"
    script "../main.nf"
    process "READ_VCF_CHR"

	test("read_vcf_chr") {

        when {
            process {
                """                
                vcf = file("${moduleDir}/tests/testdata/test.vcf.gz")
                vcf_index = file("${moduleDir}/tests/testdata/test.vcf.gz.csi")

                input[0] = tuple([:], vcf, vcf_index)
                """
            }
        }

        then {
            assert process.success

            // Passed through input should not change
            assert path(process.out.get(0).get(0).get(1)).md5 == path("${moduleDir}/tests/testdata/test.vcf.gz").md5
            assert path(process.out.get(0).get(0).get(2)).md5 == path("${moduleDir}/tests/testdata/test.vcf.gz.csi").md5

            // Verify output matches expected output
            assert file(process.out.get(0).get(0).get(3)).name == "1.chrom"
            assert path(process.out.get(0).get(0).get(3)).md5 == "d41d8cd98f00b204e9800998ecf8427e"
        }
    }
}