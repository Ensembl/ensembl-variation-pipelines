nextflow_process {

    name "Test Process REMOVE_VARIANTS"
    script "modules/local/remove_variants.nf"
    process "REMOVE_VARIANTS"

    test("Default - remove both") {

        when {
            params {
                remove_nonunique_ids = 1
                remove_patch_regions = 1
            }
            process {
                """
                genome_meta = [
                        'chrom_sizes':"${baseDir}/tests/testdata/homo_sapiens_GRCh38.chrom.sizes"
                    ]
                input[0] = tuple(genome_meta, file("$baseDir/tests/data/test_removevariants.vcf.gz"))
                """
            }
        }

        then {
            // assert process run correctly
            assert process.success
            
            // assert the content of the output file - no variant left
            def outputLines = path(process.out.get(0).get(0).get(1)).linesGzip
            def variantLines = outputLines.findAll { !it.startsWith('#') }
            assert outputLines.size() >= 1 : "Empty output file, should contain header."
            assert variantLines.size() == 0
        }

    }
    
    test("Only remove patch regions") {

        when {
            params {
                remove_nonunique_ids = 0
                remove_patch_regions = 1
            }
            process {
                """
                genome_meta = [
                        'chrom_sizes':"${baseDir}/tests/testdata/homo_sapiens_GRCh38.chrom.sizes"
                    ]
                input[0] = tuple(genome_meta, file("$baseDir/tests/data/test_removevariants.vcf.gz"))
                """
            }
        }

        then {
            // assert process run correctly
            assert process.success

            // assert the content of the output file - 1 variants
            def variantLines = path(process.out.get(0).get(0).get(1)).linesGzip.findAll { !it.startsWith('#') }
            assert variantLines.size() == 1

        }

    }
    
    test("Only remove non-unique ids") {

        when {
            params {
                remove_nonunique_ids = 1
                remove_patch_regions = 0
            }
            process {
                """
                genome_meta = [
                        'chrom_sizes':"${baseDir}/tests/testdata/homo_sapiens_GRCh38.chrom.sizes"
                    ]
                input[0] = tuple(genome_meta, file("$baseDir/tests/data/test_removevariants.vcf.gz"))
                """
            }
        }

        then {
            // assert process run correctly
            assert process.success
            
            // assert the content of the output file - 1 variant
            def variantLines = path(process.out.get(0).get(0).get(1)).linesGzip.findAll { !it.startsWith('#') }
            assert variantLines.size() == 1
        }

    }
    
    test("Only remove position-based") {

        when {
            params {
                remove_nonunique_ids = 0
                remove_patch_regions = 0
            }
            process {
                """
                genome_meta = [
                        'chrom_sizes':"${baseDir}/tests/testdata/homo_sapiens_GRCh38.chrom.sizes"
                    ]
                input[0] = tuple(genome_meta, file("$baseDir/tests/data/test_removevariants.vcf.gz"))
                """
            }
        }

        then {
            // assert process run correctly
            assert process.success
            
            // assert the content of the output file - 3 variants
            def variantLines = path(process.out.get(0).get(0).get(1)).linesGzip.findAll { !it.startsWith('#') }
            assert variantLines.size() == 3
        }

    }

}