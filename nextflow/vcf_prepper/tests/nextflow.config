singularity.enabled = false
        
process{
	withName: SPLIT_VCF_CHR {
        memory = 50.MB
    }

    withName: SPLIT_VCF_CHR {
        memory = 10.MB
    }

    withName: runVEPonVCF {
        cpus = 1
        memory = 200.MB
    }
}

profiles {
    github {
        docker{
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }

        params.repo_dir = "${projectDir}/repos"
       
        process{        
            withLabel: bcftools {
                container = null
            }
 
            withLabel: vep {
                // VEP 116.2 matches the RUN_VEP fixture; update image and expectations together.
                container = 'ensemblorg/ensembl-vep@sha256:5c57abdc40b637cac198370b4c114777fa24de3336141fdf09d2b0c43cd4b8da'
            }
        }
    }
    local {
        params.repo_dir = "/Users/snhossain/ensembl-repos"
    }
}
